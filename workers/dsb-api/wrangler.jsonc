// dsb-api: DSB queue rules on D1 (source of truth after cutover).
// - Domain dsb-api.duarte.top for the agents only; without a valid token everything answers 401 (503 without secrets).
//   No cron of its own (the account is at the 5-cron limit of the free plan):
//   * apps (dsb-fila, dsb-auditor) call through a Service Binding with header x-internal-token (secret INTERNAL_TOKEN)
//     and x-actor;
//   * agents call https://dsb-api.duarte.top with their own Bearer: secrets TOKEN_GROK and TOKEN_CLAUDE
//     (the actor comes from the token, not the body);
//   * the issue sweep (POST /sweep) is triggered by the dsb-auditor cron and at the end of each job.
// - Environments: top level = dsb-api (production; binding DB still on dsb-staging until cutover, then the
//   production database). env.stg = dsb-api-stg on dsb-api-stg.duarte.top, always on dsb-staging
//   (deploy with --env stg). Used by dsb-queue-stg and dsb-auditor-stg. Its secrets come from the
//   Pass entries "DSB API STG - INTERNAL_TOKEN / TOKEN_GROK / TOKEN_CLAUDE", never the production ones.
// - Secrets: INTERNAL_TOKEN, TOKEN_GROK, TOKEN_CLAUDE (at least 24 characters). Never put tokens here.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dsb-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "dsb-api.duarte.top", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": false, "head_sampling_rate": 0 }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dsb-prod",
      "database_id": "d181dd85-78d4-4081-83a9-ead6e674aaf6",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "stg": {
      "name": "dsb-api-stg",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "dsb-api-stg.duarte.top", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dsb-staging",
          "database_id": "808d3914-2df5-4da9-aab7-1f19d51001d2",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
