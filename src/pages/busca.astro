---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('briefings')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const index = posts.map((post) => {
  const body = String(post.body ?? '')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/[#>*_`|\[\]]/g, ' ')
    .replace(/https?:\/\/\S+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  const tipo = ['noticia', 'incidente', 'vulnerabilidades'].includes(post.data.tipo)
    ? post.data.tipo
    : 'incidente';
  const labels = { noticia: 'Notícia', incidente: 'Incidente', vulnerabilidades: 'Vulnerabilidades' };
  return {
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    tags: post.data.tags,
    tipo,
    tipoLabel: labels[tipo] || 'Incidente',
    href: `/briefings/${post.id}`,
    date: post.data.pubDate.toLocaleDateString('pt-BR', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      timeZone: 'America/Sao_Paulo',
    }),
    text: `${post.data.title} ${post.data.description} ${tipo} ${post.data.tags.join(' ')} ${body}`,
  };
});
---
<Base title="Busca" description="Busca nos briefings publicados.">
  <p class="eyebrow">Busca</p>
  <h1>Encontrar briefing</h1>
  <form class="search" id="search-form" action="/busca" method="get" role="search">
    <label class="faint" for="q">Título e conteúdo</label>
    <input id="q" name="q" type="search" placeholder="ANPD, ransomware, menor…" autocomplete="off" />
    <fieldset class="scope-filter" id="scope-filter">
      <legend class="faint">Escopo</legend>
      <div class="scope-options" role="radiogroup" aria-label="Escopo">
        <button type="button" class="scope-btn is-active" data-scope="todos" aria-pressed="true">Todos</button>
        <button type="button" class="scope-btn" data-scope="incidente" aria-pressed="false">Incidentes</button>
        <button type="button" class="scope-btn" data-scope="noticia" aria-pressed="false">Notícias</button>
        <button type="button" class="scope-btn" data-scope="vulnerabilidades" aria-pressed="false">Vulnerabilidades</button>
      </div>
    </fieldset>
  </form>
  <p class="faint" id="search-status"></p>
  <div id="search-results" class="search-results"></div>
</Base>

<script define:vars={{ index }}>
  const fold = (s) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
  const input = document.getElementById('q');
  const status = document.getElementById('search-status');
  const results = document.getElementById('search-results');
  const form = document.getElementById('search-form');
  const scopeBtns = [...document.querySelectorAll('.scope-btn')];
  const allowed = new Set(['todos', 'incidente', 'noticia', 'vulnerabilidades']);

  const readScope = () => {
    const raw = new URLSearchParams(location.search).get('tipo') || 'todos';
    return allowed.has(raw) ? raw : 'todos';
  };

  let scope = readScope();

  const syncScopeUi = () => {
    scopeBtns.forEach((btn) => {
      const on = btn.getAttribute('data-scope') === scope;
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-pressed', String(on));
    });
  };

  const writeUrl = (q, tipo) => {
    const url = new URL(location.href);
    if (q) url.searchParams.set('q', q);
    else url.searchParams.delete('q');
    if (tipo && tipo !== 'todos') url.searchParams.set('tipo', tipo);
    else url.searchParams.delete('tipo');
    history.replaceState(null, '', url);
  };

  const labelHits = (n, tipo, hasQuery) => {
    if (!n) {
      if (hasQuery && tipo === 'incidente') return 'Nenhum incidente com esse termo.';
      if (hasQuery && tipo === 'noticia') return 'Nenhuma notícia com esse termo.';
      if (hasQuery && tipo === 'vulnerabilidades') return 'Nenhuma vulnerabilidade com esse termo.';
      if (hasQuery) return 'Nenhum briefing com esse termo.';
      if (tipo === 'incidente') return 'Nenhum incidente publicado.';
      if (tipo === 'noticia') return 'Nenhuma notícia publicada.';
      if (tipo === 'vulnerabilidades') return 'Nenhuma vulnerabilidade publicada.';
      return 'Nenhum briefing publicado.';
    }
    if (tipo === 'incidente') return `${n} incidente${n === 1 ? '' : 's'}`;
    if (tipo === 'noticia') return `${n} notícia${n === 1 ? '' : 's'}`;
    if (tipo === 'vulnerabilidades') return `${n} vulnerabilidade${n === 1 ? '' : 's'}`;
    return `${n} briefing${n === 1 ? '' : 's'}`;
  };

  function run() {
    const q = fold(input.value || '').trim();
    const terms = q.split(/\s+/).filter(Boolean);
    const hits = index.filter((post) => {
      if (scope !== 'todos' && post.tipo !== scope) return false;
      if (!terms.length) return true;
      const hay = fold(post.text);
      return terms.every((t) => hay.includes(t));
    });

    status.textContent = labelHits(hits.length, scope, Boolean(terms.length));
    results.innerHTML = hits
      .map(
        (post) => `
        <a class="card" href="${post.href}" style="text-decoration:none;color:inherit">
          <div class="card-copy">
            <div class="meta-row">
              <p class="faint">${post.date}</p>
              <span class="tipo-pill ${post.tipo}">${post.tipoLabel}</span>
            </div>
            <h2 style="font-size:22px;margin:8px 0">${post.title}</h2>
            <p class="muted">${post.description}</p>
          </div>
        </a>`
      )
      .join('');
  }

  const params = new URLSearchParams(location.search);
  input.value = params.get('q') || '';
  scope = readScope();
  syncScopeUi();
  run();

  input.addEventListener('input', () => {
    writeUrl(input.value, scope);
    run();
  });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    writeUrl(input.value, scope);
    run();
  });
  scopeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      scope = btn.getAttribute('data-scope') || 'todos';
      syncScopeUi();
      writeUrl(input.value, scope);
      run();
    });
  });
  input.focus();
</script>
