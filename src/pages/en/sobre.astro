---
import Base from '../../layouts/Base.astro';
import { buildStamp } from '../../lib/build';
const mailHref =
  'mailto:dsb@duarte.top?subject=' +
  encodeURIComponent('Data Security Briefing') +
  '&body=' +
  encodeURIComponent('Hello Marcelo,\n\nI am writing about: (critique, suggestion, contribution or other)\n\n');
---
<Base locale="en" path="/sobre" title="About" description="Marcelo Duarte and Data Security Briefing.">
  <article class="prose">
    <p class="eyebrow">About</p>
    <h1>Marcelo Duarte</h1>
    <p>More than two decades working with data in Latin America. Today he is a Senior Customer Success Architect at BigID, in Rio de Janeiro. Knowing where sensitive data lives, classifying it, setting use policies and managing those processes proactively is the foundation of security governance that can face artificial intelligence.</p>
    <p>Data Security Briefing is the archive of that reading. Breaches, DSPM, governance and data-protection rules — LGPD/ANPD and regional counterparts. Pieces summarized on LinkedIn and, here, the full version with sources and actions for each topic.</p>
    <p>The archive has three desks: <strong>Incident</strong> (the case), <strong>News</strong> (governance and regulation) and <strong>Vulnerabilities</strong> (the exploitable hole before a breach). The aim is a single reading point — a one-stop shop — for people who decide on data in Latin America.</p>
    <p>To open the site as an app on the home screen, the steps are in <a href="/en/instalar">Install</a>.</p>
    <p>Critique, suggestion or contribution: <a href={mailHref}>dsb@duarte.top</a>.</p>
    <div class="social">
      <a class="social-link" href="https://www.linkedin.com/in/marceloduartebr" rel="me noopener noreferrer" target="_blank" aria-label="Marcelo Duarte on LinkedIn">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3.5 9.5h3v11h-3v-11ZM10 9.5h2.9v1.5h.04c.4-.76 1.4-1.56 2.88-1.56 3.08 0 3.65 2.03 3.65 4.67V20.5h-3v-5.5c0-1.31-.02-3-1.83-3-1.83 0-2.11 1.43-2.11 2.9v5.6h-3v-11Z"/></svg>
        <span>LinkedIn</span>
      </a>
      <a class="social-link" href="https://x.com/DSBriefing" rel="me noopener noreferrer" target="_blank" aria-label="DSB on X">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M17.3 3H20.2l-6.6 7.5L21.5 21h-5.7l-4.5-5.8L6.1 21H3.2l7-8L2.7 3h5.8l4 5.3L17.3 3Zm-1 16.2h1.6L7.8 4.7H6.1l10.2 14.5Z"/></svg>
        <span>X</span>
      </a>
    </div>
    <figure class="qr-share">
      <button type="button" class="qr-open" aria-label="Enlarge QR code">
        <img src="/qr.png" width="220" height="220" alt="Data Security Briefing QR code" />
      </button>
      <figcaption>
        <strong>Share the site</strong>
        Scan or <a href="/qr.png" download="dsb-qrcode.png">download the QR code</a>. Opens dsb.duarte.top.
      </figcaption>
    </figure>
    <p class="faint" style="margin-top:28px;letter-spacing:.06em">{buildStamp}</p>
  </article>
</Base>
