---
import Base from '../layouts/Base.astro';
// VAPID pública (repo ok). Privada só em ~/.config/dsb/vapid.json no box.
const VAPID_PUBLICA = 'BBil-vzxxUdz652VnUs1k8vLSJ5RWaZNFNfcSxNv65u2AKBl41-zpcx2xICyJ1TMY2Pcpl7XcHN7kBuIyZdCiaQ';
const siteUrl = 'https://dsb.duarte.top';
const TIPOS = [
  { id: 'noticia', label: 'Notícias' },
  { id: 'vulnerabilidades', label: 'Vulnerabilidades' },
  { id: 'incidente', label: 'Incidentes' },
];
const REGIOES = [
  { id: 'br', label: 'Brasil' },
  { id: 'mx', label: 'México' },
  { id: 'latam', label: 'LATAM' },
  { id: 'us', label: 'EUA' },
  { id: 'eu', label: 'Europa' },
  { id: 'global', label: 'Global' },
];
---
<Base
  locale="pt"
  path="/notificacoes"
  title="Notificações"
  description="Escolha tipos e regiões e ative avisos no celular quando sair um novo briefing no Data Security Briefing."
>
  <article class="prose notif-pag">
    <p class="eyebrow">App</p>
    <h1>Receber avisos de novos briefings</h1>
    <p>
      Escolha o que quer receber. Quando um briefing novo entrar no ar com esses filtros, você recebe um aviso no celular ou no computador.
      Toque e o DSB abre na página certa. É grátis; dá para desligar quando quiser.
    </p>

    <div class="notif-caixa" id="notif" data-vapid={VAPID_PUBLICA}>
      <p class="notif-estado" id="notif-estado" aria-live="polite">Verificando o seu aparelho…</p>

      <div class="notif-prefs" id="notif-prefs" hidden>
        <fieldset class="notif-field">
          <legend>Tipo</legend>
          <div class="notif-checks">
            {TIPOS.map((t) => (
              <label class="notif-check">
                <input type="checkbox" name="tipo" value={t.id} checked />
                <span>{t.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset class="notif-field">
          <legend>Região</legend>
          <div class="notif-checks">
            {REGIOES.map((r) => (
              <label class="notif-check">
                <input type="checkbox" name="regiao" value={r.id} checked />
                <span>{r.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <p class="notif-dica">LATAM cobre Argentina, Chile, Peru, Paraguai, Uruguai, Colômbia e itens marcados como LATAM.</p>
      </div>

      <div class="notif-botoes">
        <button type="button" class="notif-btn notif-btn-pri" id="notif-ativar" hidden>Receber avisos</button>
        <button type="button" class="notif-btn notif-btn-pri" id="notif-salvar" hidden>Salvar preferências</button>
        <button type="button" class="notif-btn" id="notif-desativar" hidden>Parar de receber avisos</button>
      </div>
      <div class="notif-ios" id="notif-ios" hidden>
        <p><strong>No iPhone, os avisos só funcionam com o DSB instalado na Tela de Início</strong> (iOS 16.4 ou mais novo):</p>
        <ol>
          <li>Abra {siteUrl} no Safari.</li>
          <li>Toque em Compartilhar (quadrado com seta).</li>
          <li>Escolha «Adicionar à Tela de Início» e confirme.</li>
          <li>Abra o DSB pelo ícone novo, volte a esta página e toque em «Receber avisos».</li>
        </ol>
        <p><a href="/instalar">Como instalar o app</a></p>
      </div>
    </div>

    <h2>Como funciona</h2>
    <ul>
      <li><strong>Android:</strong> Chrome, mesmo sem instalar. Escolha tipo e região, toque em «Receber avisos» e depois em «Permitir».</li>
      <li><strong>iPhone:</strong> primeiro adicione o DSB à Tela de Início, abra pelo ícone e ative aqui.</li>
      <li><strong>Windows / Mac / Linux:</strong> Chrome ou Edge com o site (ou o app instalado).</li>
      <li>Para parar: «Parar de receber avisos» nesta página, ou bloqueie as notificações do DSB nos ajustes do sistema.</li>
    </ul>
  </article>
</Base>

<style>
  .notif-caixa {
    border: 1px solid #2a3140;
    background: #12171f;
    border-radius: 14px;
    padding: 1.1rem 1.2rem;
    margin: 1.4rem 0 2rem;
  }
  .notif-estado { margin: 0 0 0.8rem; color: #d7dce6; }
  .notif-prefs { margin: 0 0 1rem; }
  .notif-field {
    border: 0;
    margin: 0 0 0.85rem;
    padding: 0;
  }
  .notif-field legend {
    font-weight: 700;
    color: #eef1f6;
    margin-bottom: 0.45rem;
  }
  .notif-checks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.7rem;
  }
  .notif-check {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid #3a4558;
    background: #1a2130;
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
    font-size: 0.92rem;
    color: #d7dce6;
  }
  .notif-check:has(input:checked) {
    border-color: #c9a227;
    color: #eef1f6;
  }
  .notif-check input {
    accent-color: #c9a227;
    margin: 0;
  }
  .notif-dica {
    margin: 0.2rem 0 0;
    font-size: 0.88rem;
    color: #9aa3b2;
  }
  .notif-botoes { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .notif-btn {
    appearance: none;
    border: 1px solid #3a4558;
    background: #1a2130;
    color: #eef1f6;
    border-radius: 10px;
    padding: 0.55rem 0.95rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .notif-btn:hover { border-color: #c9a227; }
  .notif-btn-pri {
    background: #c9a227;
    border-color: #c9a227;
    color: #0b0e13;
  }
  .notif-btn:disabled { opacity: 0.6; cursor: wait; }
  .notif-ios { margin-top: 0.8rem; }
  .notif-ios ol { padding-left: 1.2rem; }
</style>

<script>
  const KEY = 'dsb-push-prefs';
  const TIPOS_ALL = ['noticia', 'vulnerabilidades', 'incidente'];
  const REGIOES_ALL = ['br', 'mx', 'latam', 'us', 'eu', 'global'];

  const caixa = document.getElementById('notif');
  const estado = document.getElementById('notif-estado');
  const prefs = document.getElementById('notif-prefs');
  const bAtivar = document.getElementById('notif-ativar');
  const bSalvar = document.getElementById('notif-salvar');
  const bDesativar = document.getElementById('notif-desativar');
  const ios = document.getElementById('notif-ios');
  const VAPID = caixa && caixa.dataset.vapid;

  const ehIOS =
    /iphone|ipad|ipod/i.test(navigator.userAgent) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const standalone =
    matchMedia('(display-mode: standalone)').matches ||
    navigator.standalone === true;
  const suporta =
    'serviceWorker' in navigator &&
    'PushManager' in window &&
    'Notification' in window;

  function chaveBytes(b64) {
    const p = '='.repeat((4 - (b64.length % 4)) % 4);
    const s = atob((b64 + p).replace(/-/g, '+').replace(/_/g, '/'));
    return Uint8Array.from(s, (c) => c.charCodeAt(0));
  }
  async function api(rota, corpo) {
    const r = await fetch('/api/push/' + rota, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(corpo),
    });
    if (!r.ok) throw new Error('HTTP ' + r.status);
    return r.json().catch(() => ({ ok: true }));
  }
  function lerChecks(name) {
    return [...document.querySelectorAll('input[name="' + name + '"]:checked')].map(
      (el) => el.value,
    );
  }
  function aplicarChecks(name, valores) {
    const set = new Set(valores);
    document.querySelectorAll('input[name="' + name + '"]').forEach((el) => {
      el.checked = set.has(el.value);
    });
  }
  function carregarPrefs() {
    try {
      const raw = localStorage.getItem(KEY);
      if (!raw) return { tipos: TIPOS_ALL.slice(), regioes: REGIOES_ALL.slice() };
      const p = JSON.parse(raw);
      const tipos = Array.isArray(p.tipos)
        ? p.tipos.filter((t) => TIPOS_ALL.includes(t))
        : TIPOS_ALL.slice();
      const regioes = Array.isArray(p.regioes)
        ? p.regioes.filter((r) => REGIOES_ALL.includes(r))
        : REGIOES_ALL.slice();
      return {
        tipos: tipos.length ? tipos : TIPOS_ALL.slice(),
        regioes: regioes.length ? regioes : REGIOES_ALL.slice(),
      };
    } catch {
      return { tipos: TIPOS_ALL.slice(), regioes: REGIOES_ALL.slice() };
    }
  }
  function salvarPrefsLocal(tipos, regioes) {
    try {
      localStorage.setItem(KEY, JSON.stringify({ tipos, regioes }));
    } catch (_) {}
  }
  function prefsDaTela() {
    return { tipos: lerChecks('tipo'), regioes: lerChecks('regiao') };
  }
  function mostra(ativo) {
    bAtivar.hidden = ativo;
    bSalvar.hidden = !ativo;
    bDesativar.hidden = !ativo;
    estado.textContent = ativo
      ? 'Os avisos estão ativados neste aparelho. Ajuste tipo e região e salve se quiser.'
      : 'Os avisos estão desligados neste aparelho. Escolha tipo e região e ative.';
  }
  async function reg() {
    return (
      (await navigator.serviceWorker.getRegistration()) ||
      navigator.serviceWorker.register('/sw.js', { updateViaCache: 'none' })
    );
  }
  async function upsert(sub) {
    const { tipos, regioes } = prefsDaTela();
    if (!tipos.length || !regioes.length) {
      throw new Error('prefs');
    }
    await api('subscribe', {
      subscription: sub.toJSON(),
      topicos: ['edicao'],
      tipos,
      regioes,
    });
    salvarPrefsLocal(tipos, regioes);
  }

  async function iniciar() {
    if (!caixa || !estado || !prefs || !bAtivar || !bSalvar || !bDesativar || !ios || !VAPID)
      return;
    const p = carregarPrefs();
    aplicarChecks('tipo', p.tipos);
    aplicarChecks('regiao', p.regioes);
    if (ehIOS && !standalone) {
      estado.textContent = 'Para receber avisos no iPhone, instale o DSB antes.';
      ios.hidden = false;
      return;
    }
    if (!suporta) {
      estado.textContent =
        'Este navegador não aceita notificações. No Android, use o Chrome.';
      return;
    }
    prefs.hidden = false;
    if (Notification.permission === 'denied') {
      estado.textContent =
        'As notificações do DSB estão bloqueadas. Libere nos ajustes e recarregue esta página.';
      return;
    }
    const r =
      (await navigator.serviceWorker.ready.catch(() => null)) || (await reg());
    const sub = await r.pushManager.getSubscription();
    mostra(!!sub && Notification.permission === 'granted');
  }

  bAtivar.addEventListener('click', async () => {
    const { tipos, regioes } = prefsDaTela();
    if (!tipos.length || !regioes.length) {
      estado.textContent = 'Marque ao menos um tipo e uma região.';
      return;
    }
    bAtivar.disabled = true;
    estado.textContent = 'Ativando…';
    try {
      const perm = await Notification.requestPermission();
      if (perm !== 'granted') {
        estado.textContent =
          'Você não permitiu as notificações. Se mudar de ideia, libere nos ajustes e tente de novo.';
        return;
      }
      const r = await reg();
      await navigator.serviceWorker.ready;
      let sub = await r.pushManager.getSubscription();
      if (!sub) {
        sub = await r.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: chaveBytes(VAPID),
        });
      }
      await upsert(sub);
      mostra(true);
    } catch (e) {
      console.warn(e);
      estado.textContent =
        e && e.message === 'prefs'
          ? 'Marque ao menos um tipo e uma região.'
          : 'Não deu certo agora. Verifique a internet e tente de novo.';
    } finally {
      bAtivar.disabled = false;
    }
  });

  bSalvar.addEventListener('click', async () => {
    const { tipos, regioes } = prefsDaTela();
    if (!tipos.length || !regioes.length) {
      estado.textContent = 'Marque ao menos um tipo e uma região.';
      return;
    }
    bSalvar.disabled = true;
    estado.textContent = 'Salvando…';
    try {
      const r = await reg();
      const sub = await r.pushManager.getSubscription();
      if (!sub) {
        mostra(false);
        return;
      }
      await upsert(sub);
      estado.textContent = 'Preferências salvas.';
    } catch (e) {
      console.warn(e);
      estado.textContent = 'Não deu certo salvar agora. Tente de novo.';
    } finally {
      bSalvar.disabled = false;
    }
  });

  bDesativar.addEventListener('click', async () => {
    bDesativar.disabled = true;
    try {
      const r = await reg();
      const sub = await r.pushManager.getSubscription();
      if (sub) {
        await api('unsubscribe', { endpoint: sub.endpoint }).catch(() => null);
        await sub.unsubscribe();
      }
      mostra(false);
    } catch (e) {
      console.warn(e);
      estado.textContent = 'Não deu certo agora. Tente de novo.';
    } finally {
      bDesativar.disabled = false;
    }
  });

  iniciar().catch((e) => {
    console.warn(e);
    if (estado)
      estado.textContent = 'Não foi possível verificar os avisos neste aparelho.';
  });
</script>
