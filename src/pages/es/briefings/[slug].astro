---
import BriefingArticle from '../../../components/BriefingArticle.astro';
import { listBriefings } from '../../../i18n/posts';

export async function getStaticPaths() {
  const posts = await listBriefings('es');
  return posts.map((view) => ({ params: { slug: view.id }, props: { view } }));
}

const { view } = Astro.props;
---
<BriefingArticle locale="es" view={view} />
