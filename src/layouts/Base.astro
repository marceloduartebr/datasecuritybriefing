---
import '../styles/dsb.css';
import { defaultLocale, localeHtml, localeLabel, locales, t, type Locale } from '../i18n/ui';
import { alternates, localizePath } from '../i18n/urls';

type Props = {
  title?: string;
  description?: string;
  locale?: Locale;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
};

const { title, description, locale = defaultLocale, path = '/', image, type = 'website' } = Astro.props;
const copy = t(locale);
const pageTitle = title ? `${title} · Data Security Briefing` : 'Data Security Briefing';
const feedPath = localizePath(locale, '/rss.xml');
const feedUrl = new URL(feedPath, Astro.site ?? 'https://dsb.duarte.top').href;
const pageUrl = new URL(localizePath(locale, path), Astro.site ?? 'https://dsb.duarte.top').href;
const imageUrl = image
  ? (image.startsWith('http') ? image : new URL(image, Astro.site ?? 'https://dsb.duarte.top').href)
  : new URL('/icon-512.png', Astro.site ?? 'https://dsb.duarte.top').href;
const ogLocale = locale === 'pt' ? 'pt_BR' : locale === 'es' ? 'es' : 'en';
const hrefLang = alternates(path);
const htmlLang = localeHtml[locale];
---
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      (function () {
        try {
          var ua = navigator.userAgent || '';
          if (!/iphone|ipad|ipod/i.test(ua)) return;
          if (!/(CriOS|FxiOS|EdgiOS|OPiOS|DuckDuckGo)/i.test(ua)) return;
          var href = location.href;
          if (href.indexOf('x-safari-') === 0) return;
          location.replace('x-safari-' + href);
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      (function () {
        try {
          var ua = navigator.userAgent || '';
          if (/bot|crawl|spider|slurp|facebookexternalhit|preview|headless/i.test(ua)) return;
          var path = location.pathname;
          var prefix = path === '/es' || path.indexOf('/es/') === 0 ? 'es' : (path === '/en' || path.indexOf('/en/') === 0 ? 'en' : 'pt');
          var stored = localStorage.getItem('dsb-lang');
          var want = stored;
          if (want !== 'pt' && want !== 'es' && want !== 'en') {
            want = 'pt';
            var list = navigator.languages || [navigator.language || ''];
            for (var i = 0; i < list.length; i++) {
              var tag = String(list[i] || '').toLowerCase();
              if (tag.indexOf('pt') === 0) { want = 'pt'; break; }
              if (tag.indexOf('es') === 0) { want = 'es'; break; }
              if (tag.indexOf('en') === 0) { want = 'en'; break; }
            }
            localStorage.setItem('dsb-lang', want);
          }
          if (want === prefix) return;
          var rest = prefix === 'pt' ? path : (path.replace(/^\/(es|en)/, '') || '/');
          if (!rest) rest = '/';
          var next = want === 'pt' ? rest : ('/' + want + (rest === '/' ? '' : rest));
          location.replace(next + location.search + location.hash);
        } catch (e) {}
      })();
    </script>
    <meta name="theme-color" content="#0b0e13" />
    <meta name="color-scheme" content="dark" />
    <meta name="application-name" content="Data Security Briefing" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content="DSB" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={pageUrl} />
    <meta property="og:site_name" content="Data Security Briefing" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:alt" content={title ?? 'Data Security Briefing'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icon-180.png?v=2" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,600&display=swap" rel="stylesheet" />
    <link rel="alternate" type="application/rss+xml" title="Data Security Briefing" href={feedUrl} />
    <link rel="alternate" hreflang="pt-BR" href={hrefLang.pt} />
    <link rel="alternate" hreflang="es" href={hrefLang.es} />
    <link rel="alternate" hreflang="en" href={hrefLang.en} />
    <link rel="alternate" hreflang="x-default" href={hrefLang.pt} />
  </head>
  <body>
    <div class="ptr" hidden>
      <span class="ptr-ring" aria-hidden="true"></span>
      <span class="ptr-label"></span>
    </div>
    <div class="wrap">
      <header class="site">
        <a class="brand" href={localizePath(locale, '/')}>
          <img class="mark" src="/fila-icon-512.png" width="52" height="52" alt="" />
          <span>
            <strong class="brand-title">Data Security Briefing</strong>
            <small><em>{copy.brandBy}</em> Marcelo Duarte</small>
          </span>
        </a>
        <nav class="site">
          <a href={localizePath(locale, '/')}>{copy.navBriefings}</a>
          <a href={localizePath(locale, '/busca')}>{copy.navSearch}</a>
          <a href={localizePath(locale, '/sobre')}>{copy.navAbout}</a>
          <a href={localizePath(locale, '/instalar')}>{copy.navInstall}</a>
          <div class="rss">
            <button type="button" class="rss-toggle" aria-expanded="false" aria-controls="rss-panel">{copy.rss}</button>
            <div id="rss-panel" class="rss-panel" hidden>
              <p class="rss-hint">{copy.rssHint}</p>
              <button type="button" class="rss-copy" data-feed={feedUrl}>{copy.rssCopy}</button>
              <a class="rss-download" href={feedPath} download="datasecuritybriefing.xml">{copy.rssDownload}</a>
            </div>
          </div>
          <nav class="lang" aria-label="Language">
            {locales.map((item, i) => (
              <>
                {i > 0 && <span class="sep" aria-hidden="true">·</span>}
                <a
                  href={item === 'pt' ? (path === '/' ? '/' : path) : `/${item}${path === '/' ? '' : path}`}
                  class={item === locale ? 'is-active' : undefined}
                  aria-current={item === locale ? 'true' : undefined}
                  data-locale={item}
                >{localeLabel[item]}</a>
              </>
            ))}
          </nav>
        </nav>
        <div class="acoes">
          <a class="btn-icone" href="https://www.facebook.com/DSBriefing" target="_blank" rel="noopener" aria-label={locale === 'pt' ? 'DSB no Facebook' : locale === 'es' ? 'DSB en Facebook' : 'DSB on Facebook'} title="Facebook">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><path d="M15.5 7.5h-1.6a2.4 2.4 0 0 0-2.4 2.4V21M9.5 13h5.5"/></svg>
          </a>
          <a class="btn-icone" href="https://x.com/DSBriefing" target="_blank" rel="noopener" aria-label={copy.navX} title="X">
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M17.3 3H20.2l-6.6 7.5L21.5 21h-5.7l-4.5-5.8L6.1 21H3.2l7-8L2.7 3h5.8l4 5.3L17.3 3Zm-1 16.2h1.6L7.8 4.7H6.1l10.2 14.5Z"/></svg>
          </a>
          <button type="button" class="btn-icone qr-open" aria-label={locale === 'pt' ? 'Mostrar o QR code do site' : locale === 'es' ? 'Mostrar el código QR del sitio' : 'Show the site QR code'} title="QR">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.2"/><rect x="14" y="3" width="7" height="7" rx="1.2"/><rect x="3" y="14" width="7" height="7" rx="1.2"/><path d="M6.5 6.5h0M17.5 6.5h0M6.5 17.5h0" stroke-width="2.6"/><path d="M14 14h3v3M21 14v.01M14 21h3M20 17v4h1"/></svg>
          </button>
        </div>
      </header>
      <slot />
      <footer class="site">
        <p>{copy.footerLine} <a href={localizePath(locale, '/instalar')}>{copy.footerInstall}</a></p>
        <p class="copy">{copy.copy}</p>
      </footer>
    </div>
    <dialog id="qr-dialog" class="qr-dialog">
      <img src="/qr.png" alt="" />
      <button type="button" class="qr-close" aria-label={locale === 'pt' ? 'Fechar' : locale === 'es' ? 'Cerrar' : 'Close'}>×</button>
    </dialog>
    <script is:inline define:vars={{ feedUrl, copiedLabel: copy.rssCopied, defaultCopy: copy.rssCopy, refreshLabel: copy.refresh, refreshingLabel: copy.refreshing }}>
      const root = document.querySelector('.rss');
      if (root) {
        const toggle = root.querySelector('.rss-toggle');
        const panel = root.querySelector('#rss-panel');
        const copyBtn = root.querySelector('.rss-copy');
        const close = () => {
          panel.hidden = true;
          toggle.setAttribute('aria-expanded', 'false');
        };
        toggle.addEventListener('click', (event) => {
          event.stopPropagation();
          const open = panel.hidden;
          panel.hidden = !open;
          toggle.setAttribute('aria-expanded', String(open));
        });
        document.addEventListener('click', (event) => {
          if (!root.contains(event.target)) close();
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') close();
        });
        copyBtn.addEventListener('click', async () => {
          const url = copyBtn.getAttribute('data-feed') || feedUrl;
          try {
            await navigator.clipboard.writeText(url);
          } catch {
            const field = document.createElement('textarea');
            field.value = url;
            field.setAttribute('readonly', '');
            field.style.position = 'fixed';
            field.style.left = '-9999px';
            document.body.appendChild(field);
            field.select();
            document.execCommand('copy');
            field.remove();
          }
          copyBtn.textContent = copiedLabel;
          window.setTimeout(() => { copyBtn.textContent = defaultCopy; }, 1800);
        });
      }
      document.querySelectorAll('.lang a[data-locale]').forEach((link) => {
        link.addEventListener('click', () => {
          try { localStorage.setItem('dsb-lang', link.getAttribute('data-locale') || 'pt'); } catch {}
        });
      });
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
      (function () {
        const dialog = document.getElementById('qr-dialog');
        if (!dialog) return;
        document.querySelectorAll('.qr-open').forEach((btn) => {
          btn.addEventListener('click', () => {
            window.scrollTo(0, 0);
            dialog.showModal();
          });
        });
        const closeBtn = dialog.querySelector('.qr-close');
        if (closeBtn) closeBtn.addEventListener('click', () => dialog.close());
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close();
        });
      })();
      (function () {
        const bar = document.querySelector('.ptr');
        const labelEl = bar && bar.querySelector('.ptr-label');
        if (!bar || !labelEl) return;
        if (!window.matchMedia('(pointer: coarse)').matches) return;
        const THRESH = 36;
        let startY = 0;
        let pulling = false;
        let lastPull = 0;
        let busy = false;
        const atTop = () => (window.scrollY || document.documentElement.scrollTop || 0) <= 2;
        const show = (px, refreshing) => {
          lastPull = px;
          bar.hidden = false;
          bar.classList.toggle('is-visible', px > 4 || refreshing);
          bar.classList.toggle('is-refreshing', refreshing);
          bar.style.transform = 'translate(-50%, ' + Math.min(px, 64) + 'px)';
          labelEl.textContent = refreshing || px >= THRESH ? refreshingLabel : refreshLabel;
        };
        const hide = () => {
          if (busy) return;
          bar.classList.remove('is-visible', 'is-refreshing');
          bar.style.transform = '';
          bar.hidden = true;
          lastPull = 0;
        };
        const go = () => {
          busy = true;
          show(56, true);
          const ctrl = navigator.serviceWorker && navigator.serviceWorker.controller;
          if (ctrl) ctrl.postMessage({ type: 'REFRESH', url: location.href });
          window.setTimeout(() => location.reload(), 160);
        };
        window.addEventListener('touchstart', (event) => {
          if (busy || !atTop()) return;
          const t = event.target;
          if (t && t.closest && t.closest('input, textarea, select, button, .rss')) return;
          startY = event.touches[0].clientY;
          pulling = true;
          lastPull = 0;
        }, { passive: true });
        window.addEventListener('touchmove', (event) => {
          if (!pulling || busy) return;
          const dy = event.touches[0].clientY - startY;
          if (dy < 4 || !atTop()) return;
          const pull = dy * 0.9;
          show(pull, false);
          if (event.cancelable && pull > 8) event.preventDefault();
        }, { passive: false });
        window.addEventListener('touchend', () => {
          if (!pulling) return;
          pulling = false;
          if (lastPull >= THRESH) go();
          else hide();
        }, { passive: true });
        window.addEventListener('touchcancel', () => {
          pulling = false;
          hide();
        }, { passive: true });
      })();
    </script>
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "54e717139a59491abf1fad7e3817dccc"}'></script>
  </body>
</html>
