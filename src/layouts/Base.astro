---
import '../styles/dsb.css';
import { defaultLocale, localeHtml, localeLabel, locales, t, type Locale } from '../i18n/ui';
import { alternates, localizePath } from '../i18n/urls';

type Props = {
  title?: string;
  description?: string;
  locale?: Locale;
  path?: string;
};

const { title, description, locale = defaultLocale, path = '/' } = Astro.props;
const copy = t(locale);
const pageTitle = title ? `${title} · Data Security Briefing` : 'Data Security Briefing';
const feedPath = localizePath(locale, '/rss.xml');
const feedUrl = new URL(feedPath, Astro.site ?? 'https://dsb.duarte.top').href;
const hrefLang = alternates(path);
const htmlLang = localeHtml[locale];
---
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0e13" />
    <meta name="color-scheme" content="dark" />
    <meta name="application-name" content="Data Security Briefing" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="DSB" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icon-180.png?v=2" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,600&display=swap" rel="stylesheet" />
    <link rel="alternate" type="application/rss+xml" title="Data Security Briefing" href={feedUrl} />
    <link rel="alternate" hreflang="pt-BR" href={hrefLang.pt} />
    <link rel="alternate" hreflang="es" href={hrefLang.es} />
    <link rel="alternate" hreflang="en" href={hrefLang.en} />
    <link rel="alternate" hreflang="x-default" href={hrefLang.pt} />
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        <a class="brand" href={localizePath(locale, '/')}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="52" height="52" aria-hidden="true">
            <rect width="32" height="32" rx="7" fill="#0b0e13"/>
            <path d="M16 4.2L25.8 8v7.9c0 6.05-4.15 10.85-9.8 13.15C10.35 26.75 6.2 21.95 6.2 15.9V8Z" fill="none" stroke="#d4a054" stroke-width="1.65" stroke-linejoin="round"/>
            <path d="M12.45 15.2v-2.55a3.55 3.55 0 0 1 7.1 0v2.55" fill="none" stroke="#d4a054" stroke-width="1.7" stroke-linecap="round"/>
            <rect x="11.05" y="15.05" width="9.9" height="7.25" rx="1.4" fill="#d4a054"/>
            <circle cx="16" cy="18.45" r="1.2" fill="#0b0e13"/>
          </svg>
          <span>
            <strong class="brand-title">Data Security Briefing</strong>
            <small><em>{copy.brandBy}</em> Marcelo Duarte</small>
          </span>
        </a>
        <nav class="site">
          <a href={localizePath(locale, '/')}>{copy.navBriefings}</a>
          <a href={localizePath(locale, '/busca')}>{copy.navSearch}</a>
          <a href={localizePath(locale, '/sobre')}>{copy.navAbout}</a>
          <a href={localizePath(locale, '/instalar')}>{copy.navInstall}</a>
          <div class="rss">
            <button type="button" class="rss-toggle" aria-expanded="false" aria-controls="rss-panel">{copy.rss}</button>
            <div id="rss-panel" class="rss-panel" hidden>
              <p class="rss-hint">{copy.rssHint}</p>
              <button type="button" class="rss-copy" data-feed={feedUrl}>{copy.rssCopy}</button>
              <a class="rss-download" href={feedPath} download="datasecuritybriefing.xml">{copy.rssDownload}</a>
            </div>
          </div>
          <nav class="lang" aria-label="Language">
            {locales.map((item, i) => (
              <>
                {i > 0 && <span class="sep" aria-hidden="true">·</span>}
                <a
                  href={item === 'pt' ? (path === '/' ? '/' : path) : `/${item}${path === '/' ? '' : path}`}
                  class={item === locale ? 'is-active' : undefined}
                  aria-current={item === locale ? 'true' : undefined}
                  data-locale={item}
                >{localeLabel[item]}</a>
              </>
            ))}
          </nav>
        </nav>
      </header>
      <slot />
      <footer class="site">
        <p>{copy.footerLine} <a href={localizePath(locale, '/instalar')}>{copy.footerInstall}</a></p>
        <p class="copy">{copy.copy}</p>
      </footer>
    </div>
    <script is:inline define:vars={{ feedUrl, copiedLabel: copy.rssCopied, defaultCopy: copy.rssCopy }}>
      const root = document.querySelector('.rss');
      if (root) {
        const toggle = root.querySelector('.rss-toggle');
        const panel = root.querySelector('#rss-panel');
        const copyBtn = root.querySelector('.rss-copy');
        const close = () => {
          panel.hidden = true;
          toggle.setAttribute('aria-expanded', 'false');
        };
        toggle.addEventListener('click', (event) => {
          event.stopPropagation();
          const open = panel.hidden;
          panel.hidden = !open;
          toggle.setAttribute('aria-expanded', String(open));
        });
        document.addEventListener('click', (event) => {
          if (!root.contains(event.target)) close();
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') close();
        });
        copyBtn.addEventListener('click', async () => {
          const url = copyBtn.getAttribute('data-feed') || feedUrl;
          try {
            await navigator.clipboard.writeText(url);
          } catch {
            const field = document.createElement('textarea');
            field.value = url;
            field.setAttribute('readonly', '');
            field.style.position = 'fixed';
            field.style.left = '-9999px';
            document.body.appendChild(field);
            field.select();
            document.execCommand('copy');
            field.remove();
          }
          copyBtn.textContent = copiedLabel;
          window.setTimeout(() => { copyBtn.textContent = defaultCopy; }, 1800);
        });
      }
      document.querySelectorAll('.lang a[data-locale]').forEach((link) => {
        link.addEventListener('click', () => {
          try { localStorage.setItem('dsb-lang', link.getAttribute('data-locale') || 'pt'); } catch {}
        });
      });
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "54e717139a59491abf1fad7e3817dccc"}'></script>
  </body>
</html>
