---
import '../styles/dsb.css';
const { title, description } = Astro.props;
const pageTitle = title ? `${title} · Data Security Briefing` : 'Data Security Briefing';
---
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />
    <link rel="alternate" type="application/rss+xml" title="Data Security Briefing" href="/rss.xml" />
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        <a class="brand" href="/">
          <svg viewBox="0 0 40 40" aria-hidden="true">
            <rect width="40" height="40" rx="10" fill="#171c25" stroke="#2a3140"/>
            <path d="M20 11a5 5 0 00-5 5v3h10v-3a5 5 0 00-5-5z" fill="none" stroke="#d4a054" stroke-width="1.6"/>
            <rect x="12" y="19" width="16" height="12" rx="2" fill="none" stroke="#d4a054" stroke-width="1.6"/>
          </svg>
          <span>
            <small>Data Security Briefing</small>
            <b>Marcelo Duarte</b>
          </span>
        </a>
        <nav class="site">
          <a href="/">Briefings</a>
          <a href="/sobre">Sobre</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </header>
      <slot />
      <footer class="site">Marcelo Duarte · Rio de Janeiro · referência de mercado em dados e segurança</footer>
    </div>
  </body>
</html>
