---
type Link = {
  locale: string;
  href: string;
  label: string;
  hreflang: string;
  title: string;
  current: boolean;
};

type Props = {
  label: string;
  links: Link[];
};

const { label, links } = Astro.props;
---
<span class="idiomas" role="group" aria-label={label}>
  <svg class="globo" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"></path>
  </svg>
  {links.map((link) => (
    <a
      href={link.href}
      hreflang={link.hreflang}
      lang={link.hreflang}
      title={link.title}
      aria-label={link.title}
      aria-current={link.current ? 'true' : undefined}
      data-locale={link.locale}
    >{link.label}</a>
  ))}
</span>
