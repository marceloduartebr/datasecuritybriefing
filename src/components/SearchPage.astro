---
import Base from '../layouts/Base.astro';
import { localeDate, t, tipoLabel, paisLabel, type Locale } from '../i18n/ui';
import { briefingPath } from '../i18n/urls';
import { listBriefings } from '../i18n/posts';

type Props = { locale: Locale };
const { locale } = Astro.props;
const copy = t(locale);
const posts = await listBriefings(locale);
const formAction = locale === 'pt' ? '/busca' : `/${locale}/busca`;

const index = posts.map((post) => {
  const body = String(post.entry.body ?? '')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/[#>*_`|\[\]]/g, ' ')
    .replace(/https?:\/\/\S+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  const tipo = ['noticia', 'incidente', 'vulnerabilidades'].includes(post.data.tipo)
    ? post.data.tipo
    : 'incidente';
  return {
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    tipo,
    tipoLabel: tipoLabel(locale, tipo),
    pais: post.data.pais || '',
    paisLabel: paisLabel(post.data.pais),
    href: briefingPath(locale, post.id),
    date: post.data.pubDate.toLocaleDateString(localeDate[locale], {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      timeZone: 'America/Sao_Paulo',
    }),
    text: `${post.data.title} ${post.data.description} ${tipo} ${post.data.pais ?? ''} ${post.data.tags.join(' ')} ${body}`,
  };
});

const hits = copy.searchHits;
const filterEmpty = copy.filterEmpty;
---
<Base title={copy.searchTitle} description={copy.searchDesc} locale={locale} path="/busca">
  <p class="eyebrow">{copy.searchTitle}</p>
  <h1>{copy.searchH1}</h1>
  <form class="search" id="search-form" action={formAction} method="get" role="search">
    <label class="faint" for="q">{copy.searchLabel}</label>
    <input id="q" name="q" type="search" placeholder={copy.searchPlaceholder} autocomplete="off" />
    <fieldset class="scope-filter" id="region-filter">
      <legend class="faint">{copy.filterRegion}</legend>
      <div class="scope-options" role="radiogroup" aria-label={copy.filterRegion}>
        <button type="button" class="scope-btn is-active" data-region="todos" aria-pressed="true">{copy.regionAll}</button>
        <button type="button" class="scope-btn" data-region="br" aria-pressed="false">{copy.regionBr}</button>
        <button type="button" class="scope-btn" data-region="mx" aria-pressed="false">{copy.regionMx}</button>
        <button type="button" class="scope-btn" data-region="latam" aria-pressed="false">{copy.regionLatam}</button>
        <button type="button" class="scope-btn" data-region="us" aria-pressed="false">{copy.regionUs}</button>
        <button type="button" class="scope-btn" data-region="eu" aria-pressed="false">{copy.regionEu}</button>
      </div>
    </fieldset>
    <fieldset class="scope-filter" id="scope-filter">
      <legend class="faint">{copy.filterType}</legend>
      <div class="scope-options" role="radiogroup" aria-label={copy.filterType}>
        <button type="button" class="scope-btn is-active" data-scope="todos" aria-pressed="true">{copy.searchAll}</button>
        <button type="button" class="scope-btn" data-scope="incidente" aria-pressed="false">{copy.searchIncidents}</button>
        <button type="button" class="scope-btn" data-scope="noticia" aria-pressed="false">{copy.searchNews}</button>
        <button type="button" class="scope-btn" data-scope="vulnerabilidades" aria-pressed="false">{copy.searchVulns}</button>
      </div>
    </fieldset>
  </form>
  <p class="faint" id="search-status"></p>
  <div id="search-results" class="search-results"></div>
</Base>

<script define:vars={{ index, hits, filterEmpty }}>
  const fold = (s) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
  const input = document.getElementById('q');
  const status = document.getElementById('search-status');
  const results = document.getElementById('search-results');
  const form = document.getElementById('search-form');
  const scopeBtns = [...document.querySelectorAll('[data-scope]')];
  const regionBtns = [...document.querySelectorAll('[data-region]')];
  const allowed = new Set(['todos', 'incidente', 'noticia', 'vulnerabilidades']);
  const allowedReg = new Set(['todos', 'br', 'mx', 'latam', 'us', 'eu']);
  const REG = {
    br: ['br'],
    mx: ['mx'],
    latam: ['ar', 'cl', 'pe', 'py', 'uy', 'co', 'latam'],
    us: ['us'],
    eu: ['eu'],
  };
  const KEY = 'dsb-feed';

  const readPair = () => {
    const params = new URLSearchParams(location.search);
    const hasUrl = params.has('tipo') || params.has('regiao');
    let stored = {};
    if (!hasUrl) {
      try { stored = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) {}
    }
    const tRaw = hasUrl ? params.get('tipo') : stored.tipo;
    const rRaw = hasUrl ? params.get('regiao') : stored.regiao;
    return {
      tipo: allowed.has(tRaw) ? tRaw : 'todos',
      regiao: allowedReg.has(rRaw) ? rRaw : 'todos',
    };
  };

  let scope = 'todos';
  let region = 'todos';

  const syncUi = () => {
    scopeBtns.forEach((btn) => {
      const on = btn.getAttribute('data-scope') === scope;
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-pressed', String(on));
    });
    regionBtns.forEach((btn) => {
      const on = btn.getAttribute('data-region') === region;
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-pressed', String(on));
    });
  };

  const writeUrl = (q) => {
    try { localStorage.setItem(KEY, JSON.stringify({ tipo: scope, regiao: region })); } catch (e) {}
    const url = new URL(location.href);
    if (q) url.searchParams.set('q', q);
    else url.searchParams.delete('q');
    if (scope && scope !== 'todos') url.searchParams.set('tipo', scope);
    else url.searchParams.delete('tipo');
    if (region && region !== 'todos') url.searchParams.set('regiao', region);
    else url.searchParams.delete('regiao');
    history.replaceState(null, '', url);
  };

  const pick = (pair, n) => {
    const [one, many] = String(pair).split('|');
    return (n === 1 ? one : many).replace('{n}', String(n));
  };

  const inRegion = (pais) => {
    if (region === 'todos') return true;
    return (REG[region] || []).includes(pais || '');
  };

  const labelHits = (n, tipo, hasQuery) => {
    if (!n) {
      if (region !== 'todos') return filterEmpty;
      if (hasQuery && tipo === 'incidente') return hits.noneTermIncidente;
      if (hasQuery && tipo === 'noticia') return hits.noneTermNoticia;
      if (hasQuery && tipo === 'vulnerabilidades') return hits.noneTermVuln;
      if (hasQuery) return hits.noneTermAll;
      if (tipo === 'incidente') return hits.noneIncidente;
      if (tipo === 'noticia') return hits.noneNoticia;
      if (tipo === 'vulnerabilidades') return hits.noneVuln;
      return hits.noneAll;
    }
    if (tipo === 'incidente') return pick(hits.incidente, n);
    if (tipo === 'noticia') return pick(hits.noticia, n);
    if (tipo === 'vulnerabilidades') return pick(hits.vulnerabilidades, n);
    return pick(hits.all, n);
  };

  function run() {
    const q = fold(input.value || '').trim();
    const terms = q.split(/\s+/).filter(Boolean);
    const found = index.filter((post) => {
      if (scope !== 'todos' && post.tipo !== scope) return false;
      if (!inRegion(post.pais)) return false;
      if (!terms.length) return true;
      const hay = fold(post.text);
      return terms.every((term) => hay.includes(term));
    });

    status.textContent = labelHits(found.length, scope, Boolean(terms.length));
    results.innerHTML = found
      .map(
        (post) => `
        <a class="card" href="${post.href}" style="text-decoration:none;color:inherit">
          <div class="card-copy">
            <div class="meta-row">
              <p class="faint">${post.date}</p>
              <div class="pills">
                ${post.paisLabel ? `<span class="pais-pill">${post.paisLabel}</span>` : ''}
                <span class="tipo-pill ${post.tipo}">${post.tipoLabel}</span>
              </div>
            </div>
            <h2 style="font-size:22px;margin:8px 0">${post.title}</h2>
            <p class="muted">${post.description}</p>
          </div>
        </a>`
      )
      .join('');
  }

  const params = new URLSearchParams(location.search);
  input.value = params.get('q') || '';
  const pair = readPair();
  scope = pair.tipo;
  region = pair.regiao;
  syncUi();
  run();
  if (scope !== 'todos' || region !== 'todos') writeUrl(input.value);

  input.addEventListener('input', () => {
    writeUrl(input.value);
    run();
  });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    writeUrl(input.value);
    run();
  });
  scopeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      scope = btn.getAttribute('data-scope') || 'todos';
      syncUi();
      writeUrl(input.value);
      run();
    });
  });
  regionBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      region = btn.getAttribute('data-region') || 'todos';
      syncUi();
      writeUrl(input.value);
      run();
    });
  });
  input.focus();
</script>
