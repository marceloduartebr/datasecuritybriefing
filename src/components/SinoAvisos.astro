---
// Sininho do topo: só leva a /notificacoes (seleção de tipo e região).
// Marca visual se já há inscrição neste aparelho; sem ligar/desligar no clique.
import type { Locale } from '../i18n/ui';

type Props = { locale?: Locale };
const { locale = 'pt' } = Astro.props;
const href = '/notificacoes';
const label =
  locale === 'es' ? 'Recibir avisos' : locale === 'en' ? 'Get alerts' : 'Receber avisos';
---
<a
  class="btn-icone sino"
  id="sino"
  href={href}
  aria-label={label}
  title={label}
  data-label-on={locale === 'es' ? 'Avisos activados — editar preferencias' : locale === 'en' ? 'Alerts on — edit preferences' : 'Avisos ativados — editar preferências'}
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path class="corpo" d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
    <path d="M13.7 21a2 2 0 0 1-3.4 0" />
  </svg>
  <span class="marca" aria-hidden="true"></span>
</a>
<script>
  const sino = document.getElementById('sino');
  if (sino) {
    (async () => {
      try {
        if (!('serviceWorker' in navigator) || !('PushManager' in window) || !('Notification' in window))
          return;
        if (Notification.permission !== 'granted') return;
        const r = await navigator.serviceWorker.getRegistration();
        const s = await r?.pushManager.getSubscription();
        if (!s) return;
        sino.classList.add('ativo');
        sino.title = sino.dataset.labelOn || sino.title;
      } catch (_) {}
    })();
  }
</script>
