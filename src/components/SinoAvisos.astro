---
// Sininho do topo: ativa/desativa o Web Push (mesma lógica de /notificacoes).
// iPhone fora do app, navegador sem push ou permissão bloqueada → /notificacoes.
import type { Locale } from '../i18n/ui';

type Props = { locale?: Locale };
const { locale = 'pt' } = Astro.props;
const VAPID_PUBLICA = 'BBil-vzxxUdz652VnUs1k8vLSJ5RWaZNFNfcSxNv65u2AKBl41-zpcx2xICyJ1TMY2Pcpl7XcHN7kBuIyZdCiaQ';
const label =
  locale === 'es' ? 'Recibir avisos' : locale === 'en' ? 'Get alerts' : 'Receber avisos';
---
<a
  class="btn-icone sino"
  id="sino"
  href="/notificacoes"
  role="button"
  aria-pressed="false"
  aria-label={label}
  title={label}
  data-vapid={VAPID_PUBLICA}
  data-label-on={locale === 'es' ? 'Avisos activados (toque para desactivar)' : locale === 'en' ? 'Alerts on (tap to turn off)' : 'Avisos ativados (toque para desligar)'}
  data-confirm-off={locale === 'es' ? '¿Dejar de recibir avisos del DSB en este dispositivo?' : locale === 'en' ? 'Stop getting DSB alerts on this device?' : 'Parar de receber os avisos do DSB neste aparelho?'}
  data-msg-on={locale === 'es' ? '🔔 Avisos activados. Te avisaremos de briefings nuevos.' : locale === 'en' ? '🔔 Alerts on. You will hear about new briefings.' : '🔔 Avisos ativados! Você será avisado de novos briefings.'}
  data-msg-off={locale === 'es' ? 'Avisos desactivados.' : locale === 'en' ? 'Alerts off.' : 'Avisos desligados.'}
  data-msg-denied={locale === 'es' ? 'Notificaciones no permitidas.' : locale === 'en' ? 'Notifications not allowed.' : 'Notificações não permitidas.'}
  data-msg-fail={locale === 'es' ? 'No funcionó ahora. Prueba de nuevo o abre Recibir avisos.' : locale === 'en' ? 'That did not work. Try again or open Get alerts.' : 'Não deu certo agora. Tente de novo ou abra Receber avisos.'}
  data-msg-brave={locale === 'es' ? 'En Brave: active «Usar servicios de Google para mensajes push» en brave://settings/privacy, reinicie e intente de nuevo.' : locale === 'en' ? 'In Brave: turn on “Use Google services for push messaging” at brave://settings/privacy, restart, and try again.' : 'No Brave: ative «Usar serviços do Google para mensagens push» em brave://settings/privacy, reinicie e tente de novo.'}
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path class="corpo" d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
    <path d="M13.7 21a2 2 0 0 1-3.4 0" />
  </svg>
  <span class="marca" aria-hidden="true"></span>
</a>
<div class="sino-aviso" id="sino-aviso" role="status" aria-live="polite" hidden></div>
<script>
  const sino = document.getElementById('sino');
  const aviso = document.getElementById('sino-aviso');
  if (sino && aviso) {
    const VAPID = sino.dataset.vapid;
    const ehIOS =
      /iphone|ipad|ipod/i.test(navigator.userAgent) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    const standalone =
      matchMedia('(display-mode: standalone)').matches ||
      navigator.standalone === true;
    const suporta =
      'serviceWorker' in navigator &&
      'PushManager' in window &&
      'Notification' in window;
    const direto = Boolean(VAPID) && suporta && !(ehIOS && !standalone);
    let timer;
    const fala = (t, ms = 3500) => {
      aviso.textContent = t;
      aviso.hidden = false;
      clearTimeout(timer);
      timer = setTimeout(() => {
        aviso.hidden = true;
      }, ms);
    };
    const chave = (b64) => {
      const p = '='.repeat((4 - (b64.length % 4)) % 4);
      const s = atob((b64 + p).replace(/-/g, '+').replace(/_/g, '/'));
      return Uint8Array.from(s, (c) => c.charCodeAt(0));
    };
    const api = async (rota, corpo) => {
      const r = await fetch('/api/push/' + rota, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(corpo),
      });
      if (!r.ok) throw new Error('HTTP ' + r.status);
    };
    const reg = async () =>
      (await navigator.serviceWorker.getRegistration()) ||
      navigator.serviceWorker.register('/sw.js');
    const marca = (on) => {
      sino.classList.toggle('ativo', on);
      sino.setAttribute('aria-pressed', String(on));
      sino.title = on
        ? sino.dataset.labelOn || ''
        : sino.getAttribute('aria-label') || '';
    };
    async function ehBrave() {
      try {
        if (navigator.brave && navigator.brave.isBrave)
          return !!(await navigator.brave.isBrave());
      } catch (_) {}
      return /Brave/i.test(navigator.userAgent);
    }
    if (direto) {
      (async () => {
        if (Notification.permission !== 'granted') return;
        const r = await navigator.serviceWorker.getRegistration();
        const s = await r?.pushManager.getSubscription();
        marca(!!s);
      })().catch(() => {});
      sino.addEventListener('click', async (ev) => {
        if (Notification.permission === 'denied') return;
        ev.preventDefault();
        if (sino.getAttribute('aria-busy') === 'true') return;
        sino.setAttribute('aria-busy', 'true');
        try {
          const r = await reg();
          await navigator.serviceWorker.ready;
          let sub = await r.pushManager.getSubscription();
          if (sub && Notification.permission === 'granted') {
            if (!confirm(sino.dataset.confirmOff || '')) return;
            await api('unsubscribe', { endpoint: sub.endpoint }).catch(() => null);
            await sub.unsubscribe();
            marca(false);
            fala(sino.dataset.msgOff || '');
            return;
          }
          const perm = await Notification.requestPermission();
          if (perm !== 'granted') {
            fala(sino.dataset.msgDenied || '');
            return;
          }
          if (!sub)
            sub = await r.pushManager.subscribe({
              userVisibleOnly: true,
              applicationServerKey: chave(VAPID),
            });
          await api('subscribe', {
            subscription: sub.toJSON(),
            topicos: ['edicao'],
          });
          marca(true);
          fala(sino.dataset.msgOn || '');
        } catch (e) {
          console.warn(e);
          if (await ehBrave()) fala(sino.dataset.msgBrave || '', 9000);
          else fala(sino.dataset.msgFail || '');
        } finally {
          sino.removeAttribute('aria-busy');
        }
      });
    }
  }
</script>
