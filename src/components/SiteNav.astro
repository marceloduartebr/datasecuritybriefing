---
import SeletorIdioma from './SeletorIdioma.astro';

type Item = { href: string; label: string; current: boolean };
type LangLink = {
  locale: string;
  href: string;
  label: string;
  hreflang: string;
  title: string;
  current: boolean;
};

type Props = {
  variant: 'desk' | 'mob';
  label: string;
  items: Item[];
  langLabel: string;
  langLinks: LangLink[];
};

const { variant, label, items, langLabel, langLinks } = Astro.props;
const navClass = variant === 'desk' ? 'nav-desk' : 'nav-mob container';
---
<nav class={navClass} aria-label={label}>
  {items.map((item) => (
    <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>
  ))}
  <SeletorIdioma label={langLabel} links={langLinks} />
</nav>
